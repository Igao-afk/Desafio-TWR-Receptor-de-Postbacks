generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Venda {
  id        String   @id @default(uuid())
  produto   String
  valor     Float
  status    String   @default("pago")
  criadoEm  DateTime @default(now())
}